# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Webhook ID from the same app, needed to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: real replacement prices from Channel3
CHANNEL3_API_KEY=

# Public origin of this deployment
APP_ORIGIN=http://localhost:3000
# Daily ceiling on AI inspections for the public demo
DEMO_DAILY_INSPECTION_LIMIT=60
# Daily ceiling on per-photo Claude quality checks. Past it, photos are accepted with neutral feedback
DEMO_DAILY_PHOTO_CHECK_LIMIT=400

# Optional: where the SQLite database and photo uploads live (default ./data)
HANDBACK_DATA_DIR=
# Optional: how many proxies of yours sit in front of the app. The client IP is taken that many
# entries from the right of X-Forwarded-For. Render adds one, which is the default.
TRUSTED_PROXY_HOPS=1
